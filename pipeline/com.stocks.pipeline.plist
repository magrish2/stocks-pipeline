<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stocks.pipeline</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ginomagris/Desktop/Stocks DISTRINANDO/.venv/bin/python</string>
        <string>/Users/ginomagris/Desktop/Stocks DISTRINANDO/pipeline/watch_local.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ginomagris/Desktop/Stocks DISTRINANDO</string>

    <!-- Watcher siempre vivo: sondea la carpeta local y procesa al instante.
         KeepAlive lo relanza si se cae; RunAtLoad lo arranca al prender la Mac. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Los logs van a ~/Library/Logs (NO a ~/Desktop): macOS protege Desktop
         por TCC y launchd no puede abrir ahí sus archivos de redirección
         (falla con EX_CONFIG 78 antes de arrancar). watch.py igual sigue
         escribiendo su propio pipeline/watch.log una vez que arranca. -->
    <key>StandardOutPath</key>
    <string>/Users/ginomagris/Library/Logs/stocks-pipeline.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ginomagris/Library/Logs/stocks-pipeline.err.log</string>
</dict>
</plist>
